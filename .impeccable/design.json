  "narrative": {
    "northStar": "The cabinet map table",
    "overview": "Uchrony frames a living atlas with compact, inspectable state dossiers. Blue-green slate, warm pale lettering, restrained brass controls, and muted territorial colors create the character of a working map cabinet. Alegreya gives places and historical records a distinct voice while a quiet sans-serif carries operations and comparable data.\n\nThis records the implemented, provisional code-led direction, seed ec4fabee; it is not a claim of user approval. The source is authoritative for the current build. Product mechanisms belong in PRODUCT.md, and the first-surface composition remains in .impeccable/surfaces/src-app-tsx.md.\n\nThe illuminated-atlas map treatment is a first trial accepted for exploration on 25 October 2026, inspired by Matrak\u00e7\u0131 Nasuh\u2019s city miniatures. It changes the landscape and town materials locally; it does not replace the cabinet-map interface or establish permanent approval of this art direction.",
    "keyCharacteristics": [
      "A full-height atlas beneath one compact header.",
      "Contextual, expandable dossiers and collapsible faction selection.",
      "Brass identifies actions, focus and selection; territorial colors carry map data.",
      "Alegreya carries places and history while operational data uses the platform sans-serif."
    ],
    "rules": [
      {
        "name": "The Brass Action Rule",
        "body": "Use brass for primary actions, active controls, and keyboard focus; territorial colors communicate the map\u2019s data.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Alegreya for place names, prominent values, and historical narrative; use the operational sans-serif for controls and comparable rows.",
        "section": "typography"
      },
      {
        "name": "The Cabinet Plane Rule",
        "body": "Keep persistent workspace panels flat and ruled. Reserve diffuse shadows for floating menus, tooltips, dialogs, and temporary messages.",
        "section": "elevation"
      },
      {
        "name": "The Map-local Trial Rule",
        "body": "Keep the illuminated pigments and miniature materials local to the map trial; preserve slate controls, brass actions, Alegreya lettering, and the meaning of thematic data colors.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep active state visible through an underline, selected surface, or border in addition to color.",
      "Do pair quantitative map ramps with labels and ticks, and categorical layers with their actual symbols.",
      "Do align numeric columns to the right and use tabular figures for changing quantities.",
      "Do retain visible brass keyboard focus and reduced-motion behavior.",
      "Do use actual SVG icons and the existing heraldic marks."
    ],
    "donts": [
      "Don't apply the primary-action fill to every row or panel.",
      "Don't replace ruled dossiers with a repeated grid of floating cards.",
      "Don't use territorial colors as arbitrary interface decoration.",
      "Don't generalize the smallest incidental status labels into a text-size standard."
    ]
  }
}
