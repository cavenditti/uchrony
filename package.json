{
  "name": "uchrony",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:soak": "node --import tsx tests/soak.ts",
    "format": "prettier --write src server tests vite.config.ts index.html package.json tsconfig.json",
    "format:check": "prettier --check src server tests vite.config.ts index.html package.json tsconfig.json",
    "test:trade-stability": "node --import tsx tests/trade-stability.ts",
    "test:trade-corridors": "node --import tsx tests/trade-corridors.ts"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
