# Server-side only. Never prefix this key with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

OPENROUTER_DECISION_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_STRATEGY_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_REFEREE_MODEL=nvidia/nemotron-3.5-super-vl:free

# Initial model for names and optional reading accounts; per-task choices in the UI
# are saved in .uchrony/model-settings.json and take precedence after the first save.
OPENROUTER_WRITING_MODEL=google/gemma-4-26b-a4b-it:free
